# Caminho relativo da API (o proxy do Vite encaminha /api ao backend local).
VITE_API_BASE_URL=/api/v1

# Endereço do backend usado pelo proxy do Vite em desenvolvimento (padrão: http://localhost:8080).
# Defina no .env.local se o backend rodar em outra porta. Não é enviado ao navegador.
# API_PROXY_TARGET=http://localhost:8081
