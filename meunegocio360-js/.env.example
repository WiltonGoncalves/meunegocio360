# MeuNegocio360 - variáveis do frontend (Vite)
#
# Copie para .env.local (não versionado):  cp .env.example .env.local
#
# ATENÇÃO: toda variável VITE_* é embutida no JavaScript do navegador e é PÚBLICA.
# Nunca coloque segredos, tokens ou senhas aqui.

# URL base única da API, usada para todos os serviços (decisão D-06).
# Deve estar na lista CORS_ALLOWED_ORIGINS do backend quando a origem do frontend for outra.
VITE_API_BASE_URL=http://localhost:8080/api/v1
